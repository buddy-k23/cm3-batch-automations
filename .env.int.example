# =============================================================================
# Valdo — INT-region environment template (S11-3, #401)
# =============================================================================
# Copy this to `.env.int` (scripts/valdo-setup.sh --env int does this for you if
# it is missing) and replace EVERY placeholder below with a real value supplied
# by your INT operator / secrets manager.
#
# ┌─────────────────────────────────────────────────────────────────────────┐
# │ SECURITY: this is a COMMITTED template. It MUST contain ONLY placeholders │
# │ (e.g. <INT_ORACLE_USER>, <SET_ME>). NEVER paste a real secret, password,  │
# │ signing key, or any high-entropy value into THIS file. Real values go in  │
# │ `.env.int`, which is gitignored.                                          │
# └─────────────────────────────────────────────────────────────────────────┘
#
# Placeholder convention:
#   <...>      — fill in with an INT-specific value (e.g. <INT_ORACLE_USER>)
#   <SET_ME>   — a secret you MUST supply (signing key, password, etc.)
# The setup script treats any value still containing these markers as "unset".

# --- Application -------------------------------------------------------------
# Marks this runtime as the INT region (drives config/int.json selection).
ENVIRONMENT=int
# Log verbosity for INT (DEBUG only for transient investigation).
LOG_LEVEL=INFO

# --- Database adapter --------------------------------------------------------
# INT is Oracle-backed (oracledb thin mode — no Instant Client required).
DB_ADAPTER=oracle

# --- Oracle connection (INT) -------------------------------------------------
# Oracle username for the INT schema/owner.
ORACLE_USER=<INT_ORACLE_USER>
# Oracle password — REQUIRED. Prefer a secrets manager (see SECRETS_PROVIDER
# below); when SECRETS_PROVIDER=env this must be a real value here.
ORACLE_PASSWORD=<SET_ME>
# Easy Connect DSN: host:port/service_name (e.g. int-db.bank.internal:1521/INTPDB1).
ORACLE_DSN=<INT_ORACLE_HOST>:1521/<INT_SERVICE_NAME>
# Schema prefix for SQL table references (often equal to ORACLE_USER).
ORACLE_SCHEMA=<INT_ORACLE_SCHEMA>

# --- Secrets provider --------------------------------------------------------
# Where credentials are resolved from: env (default), vault, or azure.
# In INT prefer a managed secrets backend over inline env values.
SECRETS_PROVIDER=env
#
# --- HashiCorp Vault (uncomment + fill when SECRETS_PROVIDER=vault) ----------
# VAULT_ADDR=https://<INT_VAULT_HOST>
# VAULT_ROLE_ID=<INT_VAULT_ROLE_ID>
# VAULT_SECRET_ID=<SET_ME>
# VAULT_SECRET_PATH=secret/data/valdo/int
#
# --- Azure Key Vault (uncomment + fill when SECRETS_PROVIDER=azure) ----------
# AZURE_VAULT_URL=https://<INT_KEYVAULT_NAME>.vault.azure.net

# --- API security ------------------------------------------------------------
# Comma-separated API keys (optional `key:role` suffix for RBAC).
API_KEYS=<INT_API_KEY>
# Browser Origin allow-list (https when TLS is terminated upstream).
ALLOWED_ORIGINS=https://<INT_APP_HOST>

# File retention (hours) — uploaded/temp files older than this are purged.
FILE_RETENTION_HOURS=24

# --- Session signing (LDAPS / auth.enabled) ----------------------------------
# Starlette SessionMiddleware signing key — REQUIRED in INT. Must be a 64-char
# hex string (32 random bytes). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Rotate on compromise. The app refuses to start (auth.enabled) without it.
VALDO_SESSION_SIGNING_KEY=<SET_ME>

# =============================================================================
# MCP server (Model Context Protocol surface) — INT-flavored
# =============================================================================
# INT runs with PRODUCTION signed-token auth (not the local dev gate). Values
# below are placeholders; inject real values from the secrets manager.

# Auth mode. INT uses signed-token auth — leave as "true" (NOT "dev").
VALDO_MCP_AUTH=true
# HMAC signing key for minted stdio bearer tokens — REQUIRED. 32+ random bytes.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VALDO_MCP_TOKEN_SIGNING_KEY=<SET_ME>
# On-disk path for the minted stdio bearer token (default: ~/.valdo/mcp-token).
# VALDO_MCP_TOKEN_PATH=~/.valdo/mcp-token
# Comma-separated TrustedHost allow-list for the MCP transport. In INT set the
# explicit public hostname(s) the transport is reached on (behind the proxy).
VALDO_MCP_ALLOWED_HOSTS=<INT_MCP_HOST>
# Comma-separated proxy IPs trusted for X-Forwarded-For. Set to the INT edge /
# reverse-proxy IP(s) — do NOT leave permissive in INT.
VALDO_MCP_TRUSTED_PROXIES=<INT_PROXY_IP>
# Root for the per-source onboarding sandbox (default: ~/.valdo/mcp_sandbox).
# VALDO_MCP_SANDBOX_ROOT=~/.valdo/mcp_sandbox
# Async validation. ON in INT (a live worker is expected). Set "false" only to
# force always-inline runs (e.g. before the worker is deployed).
VALDO_MCP_ASYNC_VALIDATE=true
# Epoch-seconds cutoff before which legacy no-jti tokens are still accepted.
# Leave empty in INT (no legacy tokens) — falls back to a safe rolling grace.
VALDO_MCP_JTI_GRACE_UNTIL=
# Seconds within which a heartbeat marks a worker "live" for the async fast path
# (default: 60). Comfortably larger than the worker poll interval.
# VALDO_MCP_WORKER_LIVENESS_SECONDS=60
# Per-token request cap per minute (default: 30).
VALDO_MCP_RATE_LIMIT_PER_MINUTE=30
# Per-IP request cap per minute (default: 60).
VALDO_MCP_RATE_LIMIT_PER_IP_PER_MINUTE=60
# Higher cap for lightweight run-status polling per minute (default: 240).
VALDO_MCP_RATE_LIMIT_RUN_STATUS_PER_MINUTE=240
