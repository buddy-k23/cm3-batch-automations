# Database Adapter
# Which database backend to use: oracle (default), postgresql, sqlite
# DB_ADAPTER=oracle

# === Local zero-infra default ===
# For local development the recommended setup uses SQLite — no external Oracle
# or Postgres needed. `bash scripts/valdo-setup.sh` writes these automatically.
# DB_ADAPTER=sqlite
# DB_PATH=valdo.db        # SQLite file path (relative to repo root; default valdo.db)

# Generic database connection (used by non-Oracle adapters)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=mydb

# Oracle Database Configuration
# DSN format: hostname:port/service_name  (e.g. localhost:1521/FREEPDB1)
# NOTE: Oracle Instant Client is NOT required — uses oracledb thin mode.
ORACLE_USER=APP_INT
ORACLE_PASSWORD=your_password_here
ORACLE_DSN=localhost:1521/FREEPDB1
# Schema prefix for SQL table references (defaults to ORACLE_USER if unset)
ORACLE_SCHEMA=APP_INT

# Application Configuration
ENVIRONMENT=dev
LOG_LEVEL=INFO

# API Security
# API_KEYS supports comma-separated values; optional role suffix (`key:role`) is
# accepted for future RBAC support.
API_KEYS=key-dev-abc123
# When TLS is enabled in config/ui.yml, browsers send Origin as https://...
# so the allow-list must use https. Add additional hosts as needed.
ALLOWED_ORIGINS=https://localhost,https://127.0.0.1

# File Retention (hours) — uploaded/temp files older than this are deleted on startup
FILE_RETENTION_HOURS=24

# Secrets Provider
# Which backend to use for credential retrieval: env (default), vault, azure
# SECRETS_PROVIDER=env

# HashiCorp Vault (when SECRETS_PROVIDER=vault)
# VAULT_ADDR=https://vault.example.com
# VAULT_ROLE_ID=your-approle-role-id
# VAULT_SECRET_ID=your-approle-secret-id
# VAULT_SECRET_PATH=secret/data/valdo

# Azure Key Vault (when SECRETS_PROVIDER=azure)
# AZURE_VAULT_URL=https://myvault.vault.azure.net

# File Downloader tab (non-prod only)
# Set to "true" to enable the File Downloader tab and its API endpoints.
ENABLE_FILE_DOWNLOADER=false
# Path for the download activity log (JSON lines, daily rotation).
DOWNLOADER_LOG_PATH=logs/file-downloads.log

# LDAPS Login (only used when auth.enabled: true in config/ui.yml)
# Starlette SessionMiddleware signing key — 64-char hex string;
# rotate on compromise. Without this, the app refuses to start when
# auth.enabled is true.
VALDO_SESSION_SIGNING_KEY=change-me-to-a-32-byte-random-hex-string

# Tamper-evident audit log (S13.5-1, #408)
# HMAC key for the audit-log integrity chain. When set, each audit record is
# signed with HMAC-SHA256 (hash_alg=hmac-sha256), so tampering is detectable
# even by someone with write access to the log. When UNSET, Valdo falls back
# to an UNKEYED SHA-256 chain (hash_alg=sha256) and logs a one-time warning —
# an attacker with write access could then recompute the chain. Set this in
# any environment where audit integrity matters. Verify with: valdo audit-verify
VALDO_AUDIT_HMAC_KEY=
# Service account credentials used for LDAP search_then_bind strategy.
LDAP_SERVICE_DN=CN=svc-valdo,OU=Service Accounts,DC=bank,DC=internal
LDAP_SERVICE_PASSWORD=change-me

# === MCP server ===
# Model Context Protocol surface (10 tools + 4 prompts). All values below are
# safe LOCAL/dev defaults — do NOT put real secrets here. In INT/prod these are
# injected from a secrets manager. Most vars are optional; the app applies the
# documented default when a var is unset.
#
# Auth mode. Set to "dev" to enable the local dev-auth gate (no signed tokens
# required for local clients). Leave unset/empty for production signed-token auth.
VALDO_MCP_AUTH=dev
# HMAC signing key for minted stdio bearer tokens. Dev placeholder only —
# rotate / inject a real 32+ byte secret in INT/prod.
VALDO_MCP_TOKEN_SIGNING_KEY=dev-mcp-signing-key-change-me
# On-disk path for the minted stdio bearer token (default: ~/.valdo/mcp-token).
# VALDO_MCP_TOKEN_PATH=~/.valdo/mcp-token
# Comma-separated TrustedHost allow-list for the MCP transport. In dev mode the
# allow-list is permissive; set explicit public hostnames behind a proxy.
VALDO_MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated proxy IPs trusted for X-Forwarded-For (default: 127.0.0.1).
VALDO_MCP_TRUSTED_PROXIES=127.0.0.1
# Root for the per-source onboarding sandbox (default: ~/.valdo/mcp_sandbox).
# VALDO_MCP_SANDBOX_ROOT=~/.valdo/mcp_sandbox
# Async validation. Default is ON in code (S10-2). For local-without-a-worker,
# validate_file detects no live worker and falls back to a synchronous inline
# run, so calls still complete. Set to "false" to force always-inline locally.
VALDO_MCP_ASYNC_VALIDATE=false
# Epoch-seconds cutoff before which legacy no-jti tokens are still accepted.
# Unset/empty/non-integer falls back to a safe process-start + 24h rolling grace.
# VALDO_MCP_JTI_GRACE_UNTIL=
# Seconds within which a heartbeat marks a worker "live" for the async fast path
# (default: 60). Comfortably larger than the worker poll interval.
# VALDO_MCP_WORKER_LIVENESS_SECONDS=60
# Per-token request cap per minute (default: 30).
VALDO_MCP_RATE_LIMIT_PER_MINUTE=30
# Per-IP request cap per minute (default: 60).
VALDO_MCP_RATE_LIMIT_PER_IP_PER_MINUTE=60
# Higher cap for lightweight run-status polling per minute (default: 240).
VALDO_MCP_RATE_LIMIT_RUN_STATUS_PER_MINUTE=240
