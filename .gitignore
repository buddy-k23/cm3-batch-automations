# E2E harness - extractor-regenerated artifacts
#
# SHAW TRANERT lookup CSVs and SHA-256 fingerprint are written by
# scripts/e2e_lib/extract_tranert_properties.py against the live Spring
# property file at AIT/SIT setup. The deployment-bound artifact is the
# regenerated 10_load/010_load_lookups_from_csv.sql, which IS committed.
# The CSVs are an intermediate review aid; the .sha256 is a per-environment
# idempotency fingerprint. Both regenerate on every fresh checkout.
config/e2e/sources/SHAW/lookups/

# Source-system reference materials (read-only, not for commit)
#
# Workspace-only reference files the agent reads to author SQL artifacts
# under config/e2e/sources/SHAW/. Contents include Spring property bundles,
# Oracle DSN strings, and GL cost-center mappings sourced from the SHAW
# deployment. Never git-managed under any circumstance.
/_ref/

# Local, gitignored dev-helper toolkit + transient scratch artifacts.
# Reusable Windows/CRLF/pytest-tail helpers and one-shot run output. Never
# committed; the story loop uses explicit-path 'git add' and these defend it.
/_devtools/
_*.txt
_*_report_*/

# SQLite seed DB produced by tests/manual/seed_db.py. Regenerable on demand
# from tests/manual/sql/shaw_setup_sqlite.sql; never check it in.
tests/manual/valdo_test.db
tests/manual/*.db-journal

# Regenerable SQLite DB produced by the DB-to-file reconciliation sample
# driver (templates/etl/db_to_file_reconciliation_sample/build_sample.py).
templates/etl/db_to_file_reconciliation_sample/sample.db
templates/etl/db_to_file_reconciliation_sample/*.db-journal


# local dev SQLite database (default DB_PATH)
/valdo.db
/*.db
